{
  // Covers the supplied harness (spec/, scripts/) plus the app (src/) and the
  // browser checks (e2e/), so `pnpm typecheck` checks all of it.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Imports name the file they mean, extension and all --- which is what
    // node itself wants when it runs a .ts file directly.
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    // Node runs .ts files directly by stripping types, which only works for
    // syntax it can erase (no enums, namespaces or parameter properties).
    "erasableSyntaxOnly": true
  },
  "include": ["*.ts", "spec", "scripts", "src", "e2e"]
}
