{
  "name": "comp4020-final",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "check:evidence": "node scripts/check-evidence.ts",
    "check:fast": "pnpm typecheck && vitest run --config vitest.unit.config.ts --passWithNoTests",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "log:process": "node scripts/process-log.mjs",
    "dev": "DEV=1 node --watch --watch-path=src --watch-path=README.md src/server/index.ts",
    "start": "node src/server/index.ts",
    "check:isolated": "bash scripts/check-isolated.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/ws": "8.18.2",
    "fast-check": "4.10.2",
    "jsdom": "^30.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "pnpm": ">=11"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "esbuild": "0.28.2",
    "marked": "18.1.1",
    "ws": "8.22.0"
  }
}
