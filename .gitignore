node_modules/
dist/
*.log

# editor and OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini

# keep secrets out of the repo: your API key lives in an env var or an
# untracked file, never in a tracked one
.env
.env.*
.envrc
mise.local.toml
*.pem

# Claude Code's project directory is machine-local: settings in here can hold
# your course API key, and this repo goes public when you ship. Everything in it
# stays ignored except the parts that are harness, so markers can read them:
# the subagents, slash commands, hook scripts and shared settings.json (which
# holds only the Stop hook, never a key). Personal settings stay in
# .claude/settings.local.json, which remains ignored. The pre-commit hook also
# blocks anything that looks like a key.
.claude/*
!.claude/agents/
!.claude/commands/
!.claude/hooks/
!.claude/settings.json

# mutation testing output
reports/
.stryker-tmp/

# local dev database (production uses the Fly volume at /data)
data-dev/

# Playwright output
test-results/
playwright-report/
